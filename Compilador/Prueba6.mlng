        #Debería recuperarse en el  ';'
        print("Error lexico de cadena de texto sin cerrar);
        float resultado = num1 * num2;
        boolean @ = True; #Se debe marcar error con '@' y recuperar
        return resultado;
    }

    def void main(){
        float num7 = 7.99999;
        float almacenar = 0.00;
